e]o, SPAIN\\>", "Subtitle",  TextAlignment->Center],Cell["\<\email:  jvarona@dmc.unirioja.esURL:  http://www.unirioja.es/dptos/dmc/jvarona/welcome.html\\>", "Subtitle",  TextAlignment->Center,  FontSize->18],Cell[CellGroupData[{Cell[BoxData[    \(Date[]\)], "Input"],Cell[BoxData[    \({2001, 3, 28, 13, 46, 43}\)], "Output"]}, Open  ]],Cell[CellGroupData[{Cell["Function f(z) = z^3 -1 and its derivatives", "Section"],Cell[CellGroupData[{Cell[BoxData[    \(f\  = \ Compile[{{z, _Complex}}, \ z^3 - 1]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z}, z\^3 - 1, "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]],Cell[CellGroupData[{Cell[BoxData[    \(df\  = \ Compile[{{z, _Complex}}, \ 3*z^2]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z}, 3\ z\^2, "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]],Cell[CellGroupData[{Cell[BoxData[    \(d2f\  = \ Compile[{{z, _Complex}}, \ 6*z]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z}, 6\ z, "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Roots of the function and their approximation", "Section"],Cell[BoxData[    \(Do[rootf[k]\  = \ N[Exp[2*\((k - 1)\)*Pi*I/3]], \ {k, 1, 3}]\)], "Input"],Cell[CellGroupData[{Cell[BoxData[    \(foundRoot\  = \       Compile[{{z, _Complex}}, \ \ \ \ \ \ \ \  (*\           No\ la\ uso\ *) \n\ \ \ \ \((Abs[                z\  - \ rootf[                    1]]\  < \ \ 10.0^\((\(-3\))\))\)\  || \n\ \ \ \ \ \ \ \ \\((Abs[z\  - \ rootf[                    2]]\  < \ \ 10.0^\((\(-3\))\))\)\  || \n\ \ \ \ \ \ \ \ \\((Abs[z\  - \ rootf[                    3]]\  < \ \ 10.0^\((\(-3\))\))\), \\[IndentingNewLine]{{rootf[_], _Complex}}\n\ \ \ \ ]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Abs[z - rootf[1]] < 1\/10.`\^3 || Abs[z - rootf[2]] < 1\/10.`\^3 ||           Abs[z - rootf[3]] < 1\/10.`\^3, "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]],Cell[CellGroupData[{Cell[BoxData[    \(rootPosition\  = \       Compile[{{z, _Complex}}, \n\ \ \ \ Which[          Abs[z\  - \ rootf[1]]\  < \ \ 10.0^\((\(-3\))\), \           3, \n\t\ \ \ \ \ \ \ Abs[              z\  - \ rootf[2]]\  < \ \ 10.0^\((\(-3\))\), \           2, \n\t\ \ \ \ \ \ \ Abs[              z\  - \ rootf[3]]\  < \ \ 10.0^\((\(-3\))\), \           1, \n\t\ \ \ \ \ \ \ True, \           0], \[IndentingNewLine]{{rootf[_], _Complex}}\n]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Which[Abs[z - rootf[1]] < 1\/10.`\^3, 3,           Abs[z - rootf[2]] < 1\/10.`\^3, 2, Abs[z - rootf[3]] < 1\/10.`\^3,           1, True, 0], "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Iterative methods", "Section"],Cell[CellGroupData[{Cell["Newton's method", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterNewton\  = \ Compile[{{z, _Complex}}, \ z - f[z]/df[z]]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z}, z - f[z]\/df[z], "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Newton's method for multiple roots", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterNewtonMultiple\  = \       Compile[{{z, _Complex}}, \n\t\t\tBlock[{u = \ f[z], v\  = \ df[z]},           z\  - \ \((u*v)\)\ /\ \((v*v - u*d2f[z])\)\ ]\n\t]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Block[{u = f[z], v = df[z]}, z - \(u\ v\)\/\(v\ v - u\ d2f[z]\)],         "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Convex acceleration of Whittaker's method", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterCAWhittaker\  = \       Compile[{{z, _Complex}}, \n\t\t\tBlock[{v\  = \ df[z], \             q = \ f[z]/v}, \n\t\t\tz\  - \             0.5*q\ *\ \((2.0\  - \ q*d2f[z]/v)\)\ ]\n\t]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Block[{v = df[z], q = f[z]\/v},           z - 0.5`\ q\ \((\(\(2.`\)\(\[InvisibleSpace]\)\) - \(q\ \d2f[z]\)\/v)\)], "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Double convex acceleration of Whittaker's method", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterDoubleCAWhittaker\  = \       Compile[{{z, _Complex}}, \n\t\t\tBlock[{v\  = \ df[z], \ q = f[z]/v, \             lf = q*d2f[z]/v}, \n\t\t\t\ z\  - \             0.25  q\ *\ \((\                 2.0\  - \                   lf\  + \ \((4.0 + 2.0  lf)\)/\((2.0 -                         lf*\((2.0 - lf)\))\)\ )\)]\n\t]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Block[{v = df[z], q = f[z]\/v, lf = \(q\ d2f[z]\)\/v},           z - 0.25`\ q\ \((\(\(2.`\)\(\[InvisibleSpace]\)\) -                   lf + \(\(\(4.`\)\(\[InvisibleSpace]\)\) + 2.`\ \lf\)\/\(\(\(2.`\)\(\[InvisibleSpace]\)\) - lf\ \\((\(\(2.`\)\(\[InvisibleSpace]\)\) - lf)\)\))\)], "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Halley's method", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterHalley\  = \       Compile[{{z, _Complex}}, \n\t\t\tBlock[{v\  = \ df[z]}, \           z\  - \ 1.0\ /\ \((\                 v/f[z]\  - \ \((d2f[z])\)/\((2.0  v)\))\)\ ]\n\t]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Block[{v = df[z]}, z - 1.`\/\(v\/f[z] - d2f[z]\/\(2.`\ v\)\)],         "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Chebyshev's method", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterChebyshev\  = \       Compile[{{z, _Complex}}, \n\t\t\tBlock[{v\  = \ df[z], \             q = \ f[z]/v}, \n\t\t\tz\  - \             q\ *\ \((\ 1.0\  + \ 0.5  q*d2f[z]/v\ )\)\ ]\n\t]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Block[{v = df[z], q = f[z]\/v},           z - q\ \((\(\(1.`\)\(\[InvisibleSpace]\)\) + \(0.5`\ q\ \d2f[z]\)\/v)\)], "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["\<\Convex acceleration of Newton's method or super-Halley's \method\\>", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterCANewton\  = \       Compile[{{z, _Complex}}, \n\t\t\tBlock[{v\  = \ df[z], \             q = \ f[z]/v, \ lf = q*d2f[z]/v}, \n\t\t\tz\  - \             0.5  q\ *\ \((2.0 - lf)\)\ /\ \((1.0 - lf)\)]\n\t]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Block[{v = df[z], q = f[z]\/v, lf = \(q\ d2f[z]\)\/v},           z - \(0.5`\ q\ \((\(\(2.`\)\(\[InvisibleSpace]\)\) - \lf)\)\)\/\(\(\(1.`\)\(\[InvisibleSpace]\)\) - lf\)], "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["(Shifted) Stirling's method", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterStirling\  = \       Compile[{{z, _Complex}}, \n\t\t\tBlock[{u\  = \ f[z]}, \           z\  - \ u\ /\ df[z - u]\ ]\n\t]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z}, Block[{u = f[z]}, z - u\/df[z - u]],         "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Steffensen's method", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterSteffensen\  = \       Compile[{{z, _Complex}}, \n\t\t\tBlock[{u\  = \ f[z]},           z - \ u*u\ /\ \((f[z + u] - u)\)\ ]\n\t]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Block[{u = f[z]}, z - \(u\ u\)\/\(f[z + u] - u\)],         "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Midpoint method", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterMidpoint\  = \       Compile[{{z, _Complex}}, \n\t\t\tBlock[{u\  = \ f[z]},           z\  - \ u\ /\ df[z\  - \ u/\((2.0*df[z])\)]\ ]\n\t]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Block[{u = f[z]}, z - u\/df[z - u\/\(2.`\ df[z]\)]],         "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Traub-Ostrowski's method", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterTraubOstrowski\  = \       Compile[{{z, _Complex}}, \n\t\t\tBlock[{u\  = \ f[z], q\  = u/\ df[z],             fq\  = \ f[z - q]\ }, \n\t\t\t\t\ z\  - \             q\ *\ \((fq - u)\)/\((2.0*fq - u)\)\ \ ]\n\t]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Block[{u = f[z], q = u\/df[z], fq = f[z - q]},           z - \(q\ \((fq - u)\)\)\/\(2.`\ fq - u\)], "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Jarratt's method", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterJarratt\  = \       Compile[{{z, _Complex}}, \n\t\t\tBlock[{u = f[z], v\  = \ df[z], \             q = u/v, \ a\  = \ 2.0/3.0}, \n\t\t\t\ z\  - \ 0.5  q\  + \             u\ /\ \((v - 3.0  df[z - a*q])\)\ ]\n\t]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Block[{u = f[z], v = df[z], q = u\/v, a = 2.`\/3.`},           z - 0.5`\ q + u\/\(v - 3.`\ df[z - a\ q]\)], "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Inverse-free Jarratt's method", "Subsection"],Cell[CellGroupData[{Cell[BoxData[    \(iterInvFreeJarratt\  = \       Compile[{{z, _Complex}}, \n\t\t\tBlock[{v\  = \ df[z], \ q = f[z]/v, \             a\  = \ 2.0/3.0, \             h = \((df[z - a*q] - v)\)/v}, \n\t\t\t\ z\  - \ q\  + \             0.75  q*h*\((1.0 - 1.5*h)\)\ ]\n\t]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{z},         Block[{v = df[z], q = f[z]\/v, a = 2.`\/3.`,             h = \(df[z - a\ q] - v\)\/v},           z - q + 0.75`\ q\ h\ \((\(\(1.`\)\(\[InvisibleSpace]\)\) -                   1.5`\ h)\)], "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell["Iterative algorithm and grey fractals", "Section"],Cell[BoxData[    \(Clear[iterAlgorithm, plotFractal, plotFractalToDisk]\)], "Input"],Cell[BoxData[    \(iterAlgorithm[iterMethod_, x_, y_,         lim_]\  := \n\ \ \ \ Block[{z, ct, r}, \ z\  = \ x\  + \ y\ I; \         ct\  = \ 0;         r\  = \ rootPosition[            z]; \n\ \ \ \ \ \ \ \ While[\((r == 0)\)\  && \ \((ct\  < \                 lim)\), \n\ \ \ \ \ \ \ \ \ \ \ \ \(++ct\); \           z\  = \ iterMethod[z]; \           r\  = \ rootPosition[z]\n\t\ \ \ \ \ \ ]; \n\t\t\ \ \ \ If[          Head[r] == Which,           r\  = 0]; \  (*\ "\<Which\>"\ unevaluated\ *) \n\t\t\t\ \ Return[          r]\n\ \ \ \ ]\)], "Input"],Cell[BoxData[    \(plotFractal[iterMethod_,         points_]\  := \n\ \ \ \ \ \ \ \ DensityPlot[          iterAlgorithm[iterMethod, x, y,             limIterations], \n\t\ \ \ \ \ \ \ \ \ \ \ {x, \ xxMin, \             xxMax}, \ {y, \ yyMin, \             yyMax}, \n\t\ \ \ \ \ \ \ \ \t\ \ PlotRange -> {0, 3}, \           PlotPoints -> points, \ Mesh -> False\n\t\ \ \ \ \ \ \ ]\  // \         Timing\)], "Input"],Cell[BoxData[    \(plotFractalToDisk[iterMethod_, points_,         epsFile_]\  := \n\ \ \ \ \ \ \ \ Display[          epsFile, \n\t\t\ \ \ \ \ \ \ \ \ \ \ \ \ DensityPlot[            iterAlgorithm[iterMethod, x, y,               limIterations], \n\t\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ {x, \\ xxMin, \ xxMax}, \ {y, \ yyMin, \               yyMax}, \n\t\ \ \ \ \ \ \ \ \t\ \ \ \ \ \ \ \ \ \ PlotRange -> \{0, 3}, \ PlotPoints -> points, \             Mesh -> False, \n\t\t\t\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \DisplayFunction ->               Identity\n\t\t\ \ \ \ \ \ \ \ \ \ \ \ \ ], \n\t\t\t\t\t\t\ \ \ \"\<EPS\>"\n\t\ \ \ \ \ \ \ ]\  // \ Timing\)], "Input"]}, Open  ]],Cell[CellGroupData[{Cell["Iterative algorithm and color fractals", "Section"],Cell[BoxData[    \(Clear[iterColorAlgorithm, colorLevel, fractalColor,       plotColorFractal]\)], "Input"],Cell[BoxData[    \(iterColorAlgorithm[iterMethod_, x_, y_,         lim_]\  := \n\ \ \ \ Block[{z, ct, r}, \ z\  = \ x\  + \ y\ I; \         ct\  = \ 0;         r\  = \ rootPosition[            z]; \n\ \ \ \ \ \ \ \ While[\((r == 0)\)\  && \ \((ct\  < \                 lim)\), \n\ \ \ \ \ \ \ \ \ \ \ \ \(++ct\); \           z\  = \ iterMethod[z];           r\  = \ rootPosition[z]\n\t\ \ \ \ \ \ \ ]; \n\t\t\ \ \ \ If[          Head[r] == Which,           r\  = 0]; \  (*\ "\<Which\>"\ unevaluated\ *) \n\t\ \ \ \ \ \ \ \Return[N[r + ct/\((lim + 0.001)\)]]\n\ \ \ \ ]\)], "Input"],Cell[CellGroupData[{Cell[BoxData[    \(colorLevel = Compile[{{p, _Real}}, 0.4*FractionalPart[4  p]]\)], "Input"],Cell[BoxData[    TagBox[\(CompiledFunction[{p}, 0.4`\ FractionalPart[4\ p],         "-CompiledCode-"]\),      False,      Editable->False]], "Output"]}, Open  ]],Cell[BoxData[    \(fractalColor[        p_]\  := \n\ \ \ \ Block[{pp\  = \             colorLevel[p]}, \n\ \ \ \ \ \ \ \ Switch[          IntegerPart[4  p], \n\t\ \ \ \ \ \ \ \ \t\ \ 3, \           CMYKColor[0.6 + pp, 0. , 0. , 2*pp], \n\t\ \ \ \ \ \ \ \ \t\ \ 2, \           CMYKColor[0. , 0.6 + pp, 0. , 2*pp], \n\t\ \ \ \ \ \ \ \ \t\ \ 1, \           CMYKColor[0. , 0. , 0.6 + pp, 2*pp], \n\t\ \ \ \ \ \ \ \ \t\ \ 0, \           CMYKColor[0. , 0. , 0. ,             1. ]\n\ \ \ \ \ \ \ \ ]\n\ \ \ \ ]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterMethod_,         points_]\  := \n\ \ \ \ \ \ \ \ DensityPlot[          iterColorAlgorithm[iterMethod, x, y,             limIterations], \n\t\ \ \ \ \ \ \ \ \t\ \ {x, \ xxMin, \             xxMax}, \ {y, \ yyMin, \             yyMax}, \n\t\ \ \ \ \ \ \ \ \t\ \ PlotRange -> {0, 4}, \           PlotPoints -> points, \           Mesh -> False, \n\t\ \ \ \ \ \ \ \ \t\ \ ColorFunction ->             fractalColor\n\t\ \ \ \ \ \ \ ]\  // \ Timing\)], "Input"]}, Open  ]],Cell[CellGroupData[{Cell["Global variables", "Section"],Cell[BoxData[    \(\(numberPoints\  = 512;\)\)], "Input"],Cell[BoxData[{    \(\(limIterations = 25;\)\), "\n",     \(xxMin = \(-2.5\); \ xxMax = 2.5; \ yyMin = \(-2.5\); \     yyMax = 2.5;\)}], "Input"],Cell[BoxData[    \(Off[General::ovfl]; \ \ \ \ Off[General::unfl]; \ \ \ \ Off[      Infinity::indet]\)], "Input"],Cell[BoxData[    \(Off[CompiledFunction::cccx]; \ \ \ \ Off[CompiledFunction::cfn]; \     Off[CompiledFunction::cfcx]; \ \ \ \ Off[CompiledFunction::cfex]; \     Off[CompiledFunction::crcx]; \ \ \ \ Off[CompiledFunction::cfse]; \     Off[CompiledFunction::ilsm]; \ \ \ \ Off[      CompiledFunction::cfsa]\)], "Input"]}, Open  ]],Cell[CellGroupData[{Cell["Para generar dibujos sueltos:", "Subtitle"],Cell["\<\Detener aqu\[IAcute] si \"numberPoints\" es un n\[UAcute]mero \grande.En ese caso, mejor no ejecutar nada m\[AAcute]s de este Notebook.En lugar de eso, ejecutar el dibujo de cada fractal desde un Notebook propio.\\\>", "Text"],Cell[CellGroupData[{Cell["Grey pictures", "Section"],Cell["\<\Nota: En el men\[UAcute] \"Format > Option Inspector\" seleccionar          Show option values for \"Notebook\"          y all\[IAcute], en \"Notebook Options > File Options\", poner          NotebookAutoSave como True.Con \[OAcute]rdenes de Mathematica, lo mismo se puede hacer poniendo          thisNotebook=EvaluationNotebook[];          SetOptions[thisNotebook,NotebookAutoSave->True];\\>", "Text"],Cell[BoxData[    \(plotFractal[iterNewton, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotFractal[iterNewtonMultiple, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotFractal[iterCAWhittaker, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotFractal[iterDoubleCAWhittaker, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotFractal[iterHalley, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotFractal[iterChebyshev, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotFractal[iterCANewton, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotFractal[iterStirling, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotFractal[iterSteffensen, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotFractal[iterMidpoint, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotFractal[iterTraubOstrowski, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotFractal[iterJarratt, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotFractal[iterInvFreeJarratt, \ numberPoints]\)], "Input"]}, Open  ]],Cell[CellGroupData[{Cell["Color pictures", "Section"],Cell[BoxData[    \(plotColorFractal[iterNewton, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterNewtonMultiple, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterCAWhittaker, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterDoubleCAWhittaker, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterHalley, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterChebyshev, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterCANewton, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterStirling, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterSteffensen, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterMidpoint, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterTraubOstrowski, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterJarratt, \ numberPoints]\)], "Input"],Cell[BoxData[    \(plotColorFractal[iterInvFreeJarratt, \ numberPoints]\)], "Input"]}, Open  ]]}, Open  ]]}, Open  ]]},FrontEndVersion->"4.0 for Macintosh",ScreenRectangle->{{0, 1024}, {0, 748}},NotebookAutoSave->False,WindowSize->{661, 553},WindowMargins->{{172, Automatic}, {24, Automatic}},MacintoshSystemPageSetup->"\<\00<0001804P000000`d26_oRon@3:`8f0dL5NP?N0080001804P000000`d26P010000I00000400`<30?l00BL?00400@00000000000000060801T1T0000000000000000000004000000000000000000000\>"](***********************************************************************Cached data follows.  If you edit this Notebook file directly, not usingMathematica, you must remove the line containing CacheID at the top of the file.  The cache data will then be recreated when you save this file from within Mathematica.***********************************************************************)(*CellTagsOutlineCellTagsIndex->{}*)(*CellTagsIndexCellTagsIndex->{}*)(*NotebookFileOutlineNotebook[{Cell[CellGroupData[{Cell[1739, 51, 135, 4, 174, "Title"],Cell[1877, 57, 176, 6, 139, "Subtitle"],Cell[2056, 65, 160, 5, 75, "Subtitle"],Cell[CellGroupData[{Cell[2241, 74, 39, 1, 27, "Input"],Cell[2283, 77, 59, 1, 26, "Output"]}, Open  ]],Cell[CellGroupData[{Cell[2379, 83, 61, 0, 50, "Section"],Cell[CellGroupData[{Cell[2465, 87, 76, 1, 27, "Input"],Cell[2544, 90, 127, 3, 28, "Output"]}, Open  ]],Cell[CellGroupData[{Cell[2708, 98, 75, 1, 27, "Input"],Cell[2786, 101, 126, 3, 28, "Output"]}, Open  ]],Cell[CellGroupData[{Cell[2949, 109, 74, 1, 27, "Input"],Cell[3026, 112, 123, 3, 26, "Output"]}, Open  ]]}, Open  ]],Cell[CellGroupData[{Cell[3198, 121, 64, 0, 50, "Section"],Cell[3265, 123, 93, 1, 27, "Input"],Cell[CellGroupData[{Cell[3383, 128, 486, 10, 107, "Input"],Cell[3872, 140, 237, 5, 72, "Output"]}, Open  ]],Cell[CellGroupData[{